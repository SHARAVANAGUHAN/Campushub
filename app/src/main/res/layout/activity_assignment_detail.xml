<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA">


    <!-- ===================================================== -->
    <!-- TOP BAR -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Assignment"
            android:textColor="#111111"
            android:textSize="23sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- SCROLLABLE CONTENT -->
    <!-- ===================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- ================================================= -->
            <!-- ASSIGNMENT INFORMATION CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF">

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Assignment Title"
                    android:textColor="#111111"
                    android:textSize="26sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/txtSubject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Python Programming"
                    android:textColor="#666666"
                    android:textSize="15sp" />


                <TextView
                    android:id="@+id/txtTeacher"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Teacher: Teacher Name"
                    android:textColor="#666666"
                    android:textSize="15sp" />


                <TextView
                    android:id="@+id/txtDueDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Due: 10 Oct 2026 • 11:59"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/txtMarks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Maximum Marks: 20"
                    android:textColor="#333333"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- INSTRUCTIONS -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Instructions"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Assignment instructions"
                android:textColor="#444444"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />


            <!-- ================================================= -->
            <!-- YOUR WORK -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/submissionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Work"
                    android:textColor="#111111"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/txtSubmissionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Not submitted"
                    android:textColor="#EF6C00"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/txtSubmittedTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Submitted: "
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:visibility="gone" />


                <!-- SELECTED FILE -->

                <TextView
                    android:id="@+id/txtSelectedFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Selected file"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:visibility="gone" />


                <!-- ADD ATTACHMENT -->

                <Button
                    android:id="@+id/btnAddAttachment"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:text="+  Add Attachment"
                    android:textAllCaps="false"
                    android:textSize="15sp" />


                <!-- SUBMIT -->

                <Button
                    android:id="@+id/btnSubmitAssignment"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Submit Assignment"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:enabled="false"
                    android:alpha="0.5" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- MARKS / FEEDBACK -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/feedbackSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF"
                android:visibility="gone">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teacher Feedback"
                    android:textColor="#111111"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/txtMarksObtained"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Marks: "
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />


                <TextView
                    android:id="@+id/txtFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Feedback"
                    android:textColor="#555555"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>


            <!-- BOTTOM SPACE -->

            <View
                android:layout_width="match_parent"
                android:layout_height="30dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>