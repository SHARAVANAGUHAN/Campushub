<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Library" android:textColor="#172B4D" android:textSize="25sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvLibraryCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Your personal reading shelf" android:textColor="#64748B" android:textSize="13sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddBook"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add PDF"
            android:textAllCaps="false"
            app:icon="@drawable/ic_menu_book"
            app:iconTint="#FFFFFF"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:hint="Search your books"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBookSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/libraryFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/filterAll" android:layout_width="wrap_content" android:layout_height="40dp" android:text="All" android:textAllCaps="false" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/filterReading" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Reading" android:textAllCaps="false" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/filterFinished" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Finished" android:textAllCaps="false" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBooks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="20dp" />
        <LinearLayout
            android:id="@+id/emptyLibrary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_menu_book" app:tint="#64748B" />
            <TextView android:id="@+id/tvEmptyTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="Your shelf is waiting" android:textColor="#172B4D" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvEmptyMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Add a PDF to start reading and track your progress here." android:textColor="#64748B" android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEmptyAdd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Add your first PDF" android:textAllCaps="false" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
