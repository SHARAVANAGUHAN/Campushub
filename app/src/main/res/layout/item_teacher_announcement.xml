<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:padding="16dp"
    android:elevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtAnnouncementTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Announcement Title"
            android:textColor="#172033"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAnnouncementSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Subject"
            android:textColor="#526581"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtAnnouncementMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Announcement message"
            android:textColor="#333333"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtAnnouncementDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Date"
            android:textColor="#7A8494"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>