<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:background="@drawable/header_blue">

            <View
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-70dp"
                android:layout_marginEnd="-55dp"
                android:background="@drawable/bg_circle_light"/>

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="16dp"
                android:layout_marginTop="45dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                app:tint="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="45dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:src="@drawable/ic_more_vert"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="20dp">

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leave Application"
                    android:textColor="@android:color/white"
                    android:textSize="29sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Submit a leave request"
                    android:textColor="#E8F3FF"
                    android:textSize="15sp"/>

            </LinearLayout>

        </FrameLayout>


        <!-- ========================= -->
        <!-- APPLICATION CARD -->
        <!-- ========================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLeaveForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-25dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- FORM TITLE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leave Details"
                    android:textColor="#1E293B"
                    android:textSize="20sp"
                    android:textStyle="bold"/>


                <!-- ========================= -->
                <!-- LEAVE TYPE -->
                <!-- ========================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Leave Type"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutLeaveType"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Select leave type">

                    <AutoCompleteTextView
                        android:id="@+id/spinnerLeaveType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textSize="15sp"
                        android:textColor="#1E293B"
                        android:textColorHint="#64748B"
                        android:popupBackground="@android:color/white"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"/>

                </com.google.android.material.textfield.TextInputLayout>


                <!-- ========================= -->
                <!-- FROM DATE -->
                <!-- ========================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="From Date"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutFromDate"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Select starting date"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar_month">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtFromDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:textColor="#1E293B"/>

                </com.google.android.material.textfield.TextInputLayout>


                <!-- ========================= -->
                <!-- TO DATE -->
                <!-- ========================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="To Date"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutToDate"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Select ending date"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar_month">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtToDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:textColor="#1E293B"/>

                </com.google.android.material.textfield.TextInputLayout>


                <!-- ========================= -->
                <!-- QUICK TEMPLATES -->
                <!-- ========================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Quick Templates"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMedical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Medical"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            app:cornerRadius="20dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPersonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Personal"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            app:cornerRadius="20dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEmergency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Emergency"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            app:cornerRadius="20dp"/>

                    </LinearLayout>

                </HorizontalScrollView>


                <!-- ========================= -->
                <!-- REASON / APPLICATION -->
                <!-- ========================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Reason / Application"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutReason"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Write your application here">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtReason"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="1000"
                        android:scrollbars="vertical"
                        android:overScrollMode="ifContentScrolls"
                        android:padding="14dp"
                        android:textColor="#1E293B"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp"/>

                </com.google.android.material.textfield.TextInputLayout>


                <!-- CHARACTER COUNT -->

                <TextView
                    android:id="@+id/txtCharacterCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="0 / 1000"
                    android:textColor="#64748B"
                    android:textSize="12sp"/>

                <!-- ========================= -->
                <!-- SUPPORTING DOCUMENT -->
                <!-- ========================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Supporting Document (Optional)"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:textSize="14sp"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUpload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#BBDEFB"
                    app:cardBackgroundColor="#F8FBFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:src="@drawable/ic_upload"
                            app:tint="#1976D2"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtFileName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No file selected"
                                android:textStyle="bold"
                                android:textColor="#1E293B"
                                android:textSize="15sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PDF, JPG or PNG • Optional"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpload"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upload"
                            android:textAllCaps="false"/>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ========================= -->
                <!-- SUBMIT BUTTON -->
                <!-- ========================= -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitLeave"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="24dp"
                    android:text="Submit Leave Application"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:cornerRadius="18dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ========================= -->
        <!-- INFORMATION CARD -->
        <!-- ========================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FFF8E1"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#FFE082"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="💡 Tip: Select a quick template to automatically fill your application. You can edit it before submitting."
                android:textColor="#795548"
                android:textSize="13sp"/>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>