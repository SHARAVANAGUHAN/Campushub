<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet permission for Django API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="CampusHub"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusHub"
        android:usesCleartextTraffic="true">

        <!-- Student Profile -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- Attendance -->
        <activity
            android:name=".activities.AttendanceActivity"
            android:exported="false" />

        <activity
            android:name=".activities.StudentAttendanceActivity"
            android:exported="false" />

        <activity android:name=".activities.LibraryActivity" android:exported="false" />
        <activity android:name=".activities.PdfReaderActivity" android:exported="false" />
        <activity android:name=".activities.SharedLibraryActivity" android:exported="false" />
        <activity android:name=".activities.LibrarianLoginActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".activities.LibrarianSignupActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".activities.LibrarianDashboardActivity" android:exported="false" />
        <activity android:name=".activities.LibrarianProfileActivity" android:exported="false" />

        <!-- Lecturer Profile -->
        <activity
            android:name=".activities.LecturerProfileActivity"
            android:exported="false" />
        <!-- Teacher Assignments -->
        <activity
            android:name=".activities.TeacherAssignmentsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.TimetableActivity"
            android:exported="false" />
        <activity
            android:name=".activities.LeaveApplicationActivity"
            android:exported="false" />
        <activity
            android:name=".activities.TeacherLeaveApplicationsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.TeacherAnnouncementsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.StudentAnnouncementsActivity"
            android:exported="false" />

        <!-- Teacher Assignment Submissions -->
        <activity
            android:name=".activities.TeacherAssignmentSubmissionsActivity"
            android:exported="false" />

        <!-- Password -->
        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false" />

        <!-- Assignments -->
        <activity
            android:name=".activities.AssignmentsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AssignmentDetailActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AddAssignmentActivity"
            android:exported="false" />

        <!-- Splash -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Signup Role Selection -->
        <activity
            android:name=".activities.SignupRoleActivity"
            android:exported="false" />

        <!-- Student Login -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Lecturer Login -->
        <activity
            android:name=".activities.LecturerLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Student Signup -->
        <activity
            android:name=".activities.SignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Lecturer Signup -->
        <activity
            android:name=".activities.LecturerSignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Student Dashboard -->
        <activity
            android:name=".activities.StudentDashboardActivity"
            android:exported="false" />

        <!-- Lecturer Dashboard -->
        <activity
            android:name=".activities.LecturerDashboardActivity"
            android:exported="false" />

    </application>

</manifest>
