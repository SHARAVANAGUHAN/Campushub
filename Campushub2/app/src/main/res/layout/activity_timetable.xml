<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8FC">

    <!-- ========================= -->
    <!-- HEADER -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:orientation="vertical"
        android:background="@drawable/header_blue"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="45dp">

        <!-- Back + Title -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@android:color/white"
                android:textSize="38sp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Timetable"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginTop="4dp"
            android:text="Your weekly class schedule"
            android:textColor="#DCEEFF"
            android:textSize="14sp"/>

    </LinearLayout>


    <!-- ========================= -->
    <!-- DAY SELECTOR -->
    <!-- ========================= -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@android:color/white"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/dayMon"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="5dp"
                android:gravity="center"
                android:text="MON"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_day_selected"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/dayTue"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="5dp"
                android:gravity="center"
                android:text="TUE"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/blue_primary"
                android:background="@drawable/bg_day_unselected"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/dayWed"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="5dp"
                android:gravity="center"
                android:text="WED"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/blue_primary"
                android:background="@drawable/bg_day_unselected"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/dayThu"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="5dp"
                android:gravity="center"
                android:text="THU"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/blue_primary"
                android:background="@drawable/bg_day_unselected"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/dayFri"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="5dp"
                android:gravity="center"
                android:text="FRI"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/blue_primary"
                android:background="@drawable/bg_day_unselected"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/daySat"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="5dp"
                android:gravity="center"
                android:text="SAT"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/blue_primary"
                android:background="@drawable/bg_day_unselected"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </HorizontalScrollView>


    <!-- ========================= -->
    <!-- SELECTED DAY -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/txtSelectedDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monday"
                android:textColor="#1E293B"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Today's classes"
                android:textColor="#64748B"
                android:textSize="13sp"/>

            <LinearLayout
                android:id="@+id/timetableContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>