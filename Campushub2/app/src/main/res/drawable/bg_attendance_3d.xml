<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark bottom layer = 3D depth -->
    <item android:top="7dp">

        <shape android:shape="rectangle">

            <corners android:radius="20dp"/>

            <solid android:color="#15803D"/>

        </shape>

    </item>

    <!-- Main green button -->
    <item android:bottom="7dp">

        <shape android:shape="rectangle">

            <corners android:radius="20dp"/>

            <solid android:color="#22C55E"/>

            <stroke
                android:width="1dp"
                android:color="#16A34A"/>

        </shape>

    </item>

</layer-list>