<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">


        <!-- ===================================================== -->
        <!-- PROFILE HEADER -->
        <!-- ===================================================== -->

        <FrameLayout
            android:id="@+id/profileHeader"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@drawable/header_blue">


            <!-- Decorative Circle -->

            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="-70dp"
                android:layout_marginTop="-40dp"
                android:background="@drawable/bg_circle_light" />


            <View
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-80dp"
                android:layout_marginBottom="-60dp"
                android:background="@drawable/bg_circle_dark" />


            <!-- Back Button -->

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="18dp"
                android:layout_marginTop="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                app:tint="@android:color/white" />


            <!-- Profile Content -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="28dp">


                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp">

                    <ImageView
                        android:id="@+id/imgProfileLarge"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="center"
                        android:background="@drawable/profile_circle"
                        android:clipToOutline="true"
                        android:contentDescription="Profile photo. Tap to change."
                        android:elevation="8dp"
                        android:padding="25dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person"
                        android:tint="#2563EB" />

                    <ImageButton
                        android:id="@+id/btnEditProfilePhoto"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_profile_photo_badge"
                        android:contentDescription="Add or change profile photo"
                        android:elevation="12dp"
                        android:padding="9dp"
                        android:src="@drawable/ic_add_photo"
                        app:tint="@android:color/white" />

                </FrameLayout>


                <TextView
                    android:id="@+id/txtProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Loading..."
                    android:textColor="@android:color/white"
                    android:textSize="25sp"
                    android:letterSpacing="0.015"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/txtProfileId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Loading..."
                    android:textColor="#E8F3FF"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Tap the camera to add a profile photo"
                    android:textColor="#D7E8FF"
                    android:textSize="12sp" />

            </LinearLayout>

        </FrameLayout>


        <!-- ===================================================== -->
        <!-- PERSONAL INFORMATION -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPersonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-25dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeColor="#BFDBFE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal Information"
                    android:textColor="#1565C0"
                    android:textSize="19sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:background="#BFDBFE" />


                <!-- Full Name -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textColor="#64748B"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/txtFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Loading..."
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!-- Email -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Email"
                    android:textColor="#64748B"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/txtEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Loading..."
                    android:textColor="#1E293B"
                    android:textSize="16sp" />


                <!-- Date of Birth -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Date of Birth"
                    android:textColor="#64748B"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/txtDob"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Loading..."
                    android:textColor="#1E293B"
                    android:textSize="16sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- ACADEMIC INFORMATION -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAcademic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#F8FBFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="5dp"
            app:strokeColor="#C7DFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Academic Information"
                    android:textColor="#1565C0"
                    android:textSize="19sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:background="#BFDBFE" />


                <!-- Student ID -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student ID"
                    android:textColor="#64748B"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/txtAcademicStudentId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Loading..."
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!-- Course -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Course"
                    android:textColor="#64748B"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/txtCourse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Loading..."
                    android:textColor="#1E293B"
                    android:textSize="16sp" />


                <!-- Department -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Department"
                    android:textColor="#64748B"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/txtDepartment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Loading..."
                    android:textColor="#1E293B"
                    android:textSize="16sp" />


                <!-- Current Year -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Current Year"
                    android:textColor="#64748B"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/txtYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Loading..."
                    android:textColor="#1E293B"
                    android:textSize="16sp" />


                <!-- Semester -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Semester"
                    android:textColor="#64748B"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/txtSemester"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Loading..."
                    android:textColor="#1E293B"
                    android:textSize="16sp" />


                <!-- College -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="College"
                    android:textColor="#64748B"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/txtCollege"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="SSMRV College"
                    android:textColor="#1E293B"
                    android:textSize="16sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- CONTACT INFORMATION -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="5dp"
            app:strokeColor="#C7DFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Information"
                    android:textColor="#1565C0"
                    android:textSize="19sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:background="#BFDBFE" />


                <!-- Email -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="#64748B"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/txtContactEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Loading..."
                    android:textColor="#1E293B"
                    android:textSize="16sp" />


                <!-- Phone -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Phone"
                    android:textColor="#64748B"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/txtPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Not available"
                    android:textColor="#1E293B"
                    android:textSize="16sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- ACCOUNT -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#F8FBFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="5dp"
            app:strokeColor="#C7DFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account"
                    android:textColor="#1565C0"
                    android:textSize="19sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/txtChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_profile_action"
                    android:padding="16dp"
                    android:text="🔐  Change Password"
                    android:textColor="#1D4ED8"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="Log Out"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"
                    app:cornerRadius="16dp"
                    app:strokeColor="#EF9A9A"
                    app:strokeWidth="1dp"
                    app:backgroundTint="#FFF1F2"
                    app:icon="@drawable/ic_logout"
                    app:iconTint="#D32F2F"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>

</ScrollView>
