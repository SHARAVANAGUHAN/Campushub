<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/librarianDrawerLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F3F7FB">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="238dp" android:background="@drawable/bg_librarian_hero">
                <View android:layout_width="210dp" android:layout_height="210dp" android:layout_gravity="top|end" android:layout_marginTop="-90dp" android:layout_marginEnd="-75dp" android:background="@drawable/bg_circle_light" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="22dp" android:paddingTop="25dp" android:paddingEnd="18dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.04" android:text="CAMPUSHUB LIBRARY" android:textColor="#D5F5F2" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Library dashboard" android:textColor="@android:color/white" android:textSize="25sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Books, requests, and student access" android:textColor="#E1F2FF" android:textSize="13sp" />
                    </LinearLayout>
                    <ImageButton android:id="@+id/btnProfile" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/profile_circle" android:contentDescription="Open librarian profile" android:padding="12dp" android:src="@drawable/ic_person" app:tint="#0F766E" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnNotifications" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="bottom|start" android:layout_marginStart="22dp" android:layout_marginBottom="24dp" android:text="Requests" android:textAllCaps="false" android:textColor="#0F172A" app:backgroundTint="#FFFFFF" app:cornerRadius="15dp" app:icon="@drawable/ic_notifications" app:iconTint="#0F766E" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_marginEnd="22dp" android:layout_marginBottom="38dp" android:text="Review and allot" android:textColor="#E1F2FF" android:textSize="12sp" />
            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="-1dp" android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="16dp" android:paddingEnd="12dp">
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="102dp" android:layout_marginEnd="5dp" android:layout_weight="1" app:cardBackgroundColor="#E8F1FF" app:cardCornerRadius="18dp" app:cardElevation="1dp" app:strokeColor="#C9DCFF" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
                        <TextView android:id="@+id/tvCatalogCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#1D4ED8" android:textSize="25sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Titles" android:textColor="#536987" android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="102dp" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:layout_weight="1" app:cardBackgroundColor="#E2F5F1" app:cardCornerRadius="18dp" app:cardElevation="1dp" app:strokeColor="#B7E6DA" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
                        <TextView android:id="@+id/tvAvailableCopies" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#0F766E" android:textSize="25sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Copies free" android:textColor="#47736D" android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="102dp" android:layout_marginStart="5dp" android:layout_weight="1" app:cardBackgroundColor="#FFF3DE" app:cardCornerRadius="18dp" app:cardElevation="1dp" app:strokeColor="#F7D8A6" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
                        <TextView android:id="@+id/tvPendingCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#B45309" android:textSize="25sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Requests" android:textColor="#86633D" android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingTop="22dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Book collection" android:textColor="#172B4D" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Keep the shared catalog up to date" android:textColor="#64748B" android:textSize="12sp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAddCatalogBook" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Add book" android:textAllCaps="false" app:backgroundTint="#0F766E" app:cornerRadius="13dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/librarianBookList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/notificationDrawer" android:layout_width="340dp" android:layout_height="match_parent" android:layout_gravity="end" android:background="#FFFFFF" android:elevation="16dp" android:orientation="vertical" android:paddingTop="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Request notifications" android:textColor="#172B4D" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvRequestDrawerSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Review incoming book requests" android:textColor="#64748B" android:textSize="12sp" />
            </LinearLayout>
            <ImageButton android:id="@+id/btnCloseNotificationDrawer" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Close notifications" android:src="@drawable/ic_close" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/requestDrawerTabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_marginTop="14dp" android:layout_marginEnd="14dp" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/tabPendingRequests" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Pending" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/tabAllottedBooks" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Allotted" android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="20dp">
            <LinearLayout android:id="@+id/librarianRequestsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
